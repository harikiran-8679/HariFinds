---
/** GUIDE PAGE - renders one Markdown guide plus the products it references. */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DisclosureNote from '../../components/DisclosureNote.astro';
import { SITE } from '../../config';
import { getProductById, absoluteUrl } from '../../lib/products';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// Resolve the product ids listed in the frontmatter into real products.
// Unknown ids are skipped so a typo can never break the build.
const guideProducts = (guide.data.products ?? [])
  .map((id) => getProductById(id))
  .filter((product) => product !== undefined);

const canonical = absoluteUrl(`/guides/${guide.id}/`, SITE.url);
const coverImage = guide.data.cover ?? SITE.defaultOgImage;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  image: [absoluteUrl(coverImage, SITE.url)],
  datePublished: guide.data.date.toISOString(),
  dateModified: (guide.data.updated ?? guide.data.date).toISOString(),
  inLanguage: 'en-IN',
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: absoluteUrl('/favicon.svg', SITE.url) },
  },
};
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  image={coverImage}
  type="article"
  jsonLd={articleJsonLd}
  publishedTime={guide.data.date.toISOString()}
>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: 'Guides', href: '/guides/' },
      { label: guide.data.title },
    ]}
  />

  <article class="container" style="padding-bottom:3rem;">
    <header class="page-header">
      <h1>{guide.data.title}</h1>
      <p>{guide.data.description}</p>
      <p class="muted" style="font-size:0.85rem;">
        Published <time datetime={guide.data.date.toISOString()}>
          {guide.data.date.toLocaleDateString('en-IN', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <DisclosureNote />

    {
      guideProducts.length > 0 && (
        <section class="guide-products">
          <div class="section-head">
            <h2>Finds in this guide</h2>
          </div>
          <div class="card-grid">
            {guideProducts.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>
        </section>
      )
    }

    <p style="margin-top:2rem;">
      <a class="btn btn-outline" href="/guides/">← All guides</a>
    </p>
  </article>
</BaseLayout>
