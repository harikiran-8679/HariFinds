---
/** Site footer: quick links, categories, legal pages and the Amazon disclosure. */
import { SITE, AFFILIATE_DISCLOSURE } from '../config';
import { getCategories } from '../lib/products';

const year = new Date().getFullYear();
const categories = getCategories();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">H</span>
          <span>{SITE.name}</span>
        </a>
        <p class="muted" style="margin-top:0.75rem;max-width:38ch;">
          {SITE.tagline}. A small, hand-curated list of Amazon finds for shoppers in India.
        </p>
        <a class="btn btn-outline btn-sm" href="/products/">Browse all finds</a>
      </div>

      <nav aria-label="Footer navigation">
        <h2>Explore</h2>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/products/">All finds</a></li>
          <li><a href="/guides/">Guides</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </nav>

      <nav aria-label="Categories">
        <h2>Categories</h2>
        <ul class="footer-links">
          {categories.map((category) => (
            <li>
              <a href={`/category/${category.slug}/`}>
                {category.name} ({category.count})
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-disclosure">
      <p>
        <strong>{AFFILIATE_DISCLOSURE}</strong>
      </p>
      <p>
        Product links on this site are affiliate links. If you buy through them, I may
        earn a small commission at no extra cost to you. Prices and availability on
        Amazon change constantly, so please check the current price on Amazon before
        buying. ·
        <a href="/disclosure">Affiliate disclosure</a> ·
        <a href="/privacy">Privacy policy</a>
      </p>
      <p class="muted">© {year} {SITE.name}. Amazon and the Amazon logo are trademarks of Amazon.com, Inc. or its affiliates. This site is not endorsed by Amazon.</p>
    </div>
  </div>
</footer>
